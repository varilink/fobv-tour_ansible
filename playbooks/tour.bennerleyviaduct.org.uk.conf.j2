server {

  listen 80;
  listen [::]:80;
  server_name {{ server_name }};

  access_log /var/log/nginx/{{ server_name }}-access.log;
  error_log /var/log/nginx/{{ server_name }}-error.log;

  root /var/www/{{ server_name }}/html;
  index index.htm;

{% if certbot_cert or copied_cert %}
  location / {
    return 301 https://{{ server_name }}$request_uri;
  }
{% else %}
  location / {
    try_files $uri $uri/ =404;
  }
{% endif %}

}

{% if certbot_cert or copied_cert %}
server{

  listen 443 ssl;
  listen [::]:443 ssl;
  server_name {{ server_name }};

  access_log /var/log/nginx/{{ server_name }}-access.log;
  error_log /var/log/nginx/{{ server_name }}-error.log;

  root /var/www/{{ server_name }}/html;
  index index.htm;

{% if certbot_cert %}
  ssl_certificate /etc/letsencrypt/live/{{ server_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ server_name }}/privkey.pem;
{% else %}{# must be a copied cert if not a certbot cert #}
  ssl_certificate /etc/ssl/certs/{{ cert_file_name }};
  ssl_certificate_key /etc/ssl/private/{{ cert_file_name }};
{% endif %}

  location / {
    try_files $uri $uri/ =404;
  }

}
{% endif %}
